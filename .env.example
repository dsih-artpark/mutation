# ---------------------------------------------------------------------------
# Storage — MUST be absolute host paths.
#
# These are mounted at the identical path inside the containers. The worker
# starts per-tool containers through the host Docker daemon, and the daemon
# resolves bind-mount sources on the host, so both sides must agree on the
# path. See the comment at the top of docker-compose.yml.
#
#   sudo mkdir -p /srv/dharini/runs /srv/dharini/references
#   sudo chown -R $USER /srv/dharini
# ---------------------------------------------------------------------------
RUNS_ROOT=/srv/dharini/runs
REFS_ROOT=/srv/dharini/references

# ---------------------------------------------------------------------------
# Docker socket access for the worker
#
# GID of the host's docker group:  getent group docker | cut -d: -f3
# ---------------------------------------------------------------------------
DOCKER_GID=999

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Concurrency
#
# Start at 1. Two concurrent Medaka or Clair3 stages contend for the same cores
# and both finish slower than they would back to back. Raise only once the
# run_stages table shows real peak memory and wall time.
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=1

# Per-stage ceilings, applied regardless of what a pipeline requests.
MAX_STAGE_CPUS=4
MAX_STAGE_MEMORY_GB=8
DEFAULT_STAGE_TIMEOUT_S=3600

# ---------------------------------------------------------------------------
# Webhooks
# ---------------------------------------------------------------------------
# Shared with Dharini. It verifies HMAC-SHA256 over "<timestamp>.<body>" from
# the X-Dharini-Signature header. Leave empty only for local development.
WEBHOOK_SECRET=

# Comma-separated hostnames the service is allowed to call back.
# Set this in production: a callback URL is client-supplied, and without an
# allowlist the worker can be pointed at internal services or the cloud
# metadata endpoint.
WEBHOOK_ALLOWED_HOSTS=

# Callback hosts must resolve to a public address. Loopback, link-local (the
# cloud metadata endpoint), multicast, reserved and unspecified addresses are
# always refused; private RFC1918 ranges are refused unless you opt in here.
#
# Set true ONLY if Dharini genuinely sits on a private address inside this
# network — it re-opens the SSRF surface, so pair it with
# WEBHOOK_ALLOWED_HOSTS above.
WEBHOOK_ALLOW_PRIVATE_IPS=false

WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_TIMEOUT_S=15
WEBHOOK_MAX_INLINE_VARIANTS=2000

# Used to build the artifact download URL on GET /v1/runs/{id} only. The
# webhook payload no longer carries one -- artifacts are reported by
# bucket/key once `publish` uploads them, and this endpoint survives for
# operational debugging (see the Storage section of the readme).
PUBLIC_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Pipeline defaults
# ---------------------------------------------------------------------------
SNPEFF_DB=LSDV

# A filename inside REFS_ROOT, not a path. REFS_ROOT is the only references
# directory mounted into tool containers, so a reference outside it is readable
# by the application and invisible to the tool that has to open it. The app
# refuses to start if the deprecated REFERENCE_PATH points outside REFS_ROOT.
REFERENCE_FILENAME=lsdv_reference_sequence.fasta

# Hours before artifacts are swept. Run records are kept indefinitely; only the
# bulky files are removed. A run whose webhook has not been delivered is never
# purged.
#
# Artifacts are on S3 once `publish` succeeds, so local disk is scratch. Six
# hours is enough to debug a run by hand; S3 lifecycle rules own the long term.
# A run whose artifacts have NOT reached S3 is never purged.
RETENTION_HOURS=6

# ---------------------------------------------------------------------------
# Object storage
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are deliberately absent. If the
# process cannot obtain credentials from the instance role, that is a startup
# failure, not a fallback.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=s3

# MUST SET IN PRODUCTION. Required whenever STORAGE_BACKEND=s3.
S3_BUCKET=
S3_REGION=

# MinIO endpoint for local development. Empty (the default) talks to AWS.
S3_ENDPOINT_URL=

# Client-supplied input keys must sit under this prefix. Always normalised to
# end with '/' -- without it, a startswith check on 'uploads' also accepts
# 'uploadsX/anything', a different namespace chosen by whoever supplied the key.
S3_ALLOWED_PREFIX=uploads/

# Server-generated output keys. Never client-supplied.
S3_OUTPUT_PREFIX=runs/

S3_SSE=AES256
# Required when S3_SSE=aws:kms.
S3_KMS_KEY_ID=

# LocalStore only; ignored when STORAGE_BACKEND=s3. Defaults to
# $RUNS_ROOT/_objects.
LOCAL_STORAGE_ROOT=

# Replaces MAX_UPLOAD_SIZE. The service no longer accepts an upload; this is
# the ceiling on an object it is willing to fetch. 5 GB.
MAX_INPUT_BYTES=5368709120

S3_UPLOAD_MAX_ATTEMPTS=6

# ---------------------------------------------------------------------------
# Authentication
#
# Two credentials with different powers: an API key for server-to-server
# callers (full access), and a locally-verified Dharini JWT for browsers
# (read-only, owner-scoped).
# ---------------------------------------------------------------------------

# MUST SET IN PRODUCTION. Comma-separated label:secret pairs. Empty refuses to
# start unless ALLOW_UNAUTHENTICATED=true -- same reasoning as
# REQUIRE_PINNED_IMAGES below: the insecure state must be chosen explicitly,
# never reached by forgetting to set something.
API_KEYS=

# Local development only.
ALLOW_UNAUTHENTICATED=false

# RS256 via JWKS, preferred over the HS256 secret below.
DHARINI_JWT_JWKS_URL=
# HS256 alternative to the JWKS URL.
DHARINI_JWT_SECRET=
# Both required once either verifier above is configured -- otherwise a token
# minted by any issuer for any audience would be accepted.
DHARINI_JWT_ISS=
DHARINI_JWT_AUD=
DHARINI_JWT_LEEWAY_S=30

# Comma-separated browser origins allowed to call the API. Empty disables CORS.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Progress reporting
# ---------------------------------------------------------------------------
HEARTBEAT_INTERVAL_S=10
ETA_HISTORY_RUNS=50
ETA_CACHE_TTL_S=60

# ---------------------------------------------------------------------------
# Container images
#
# Images are declared in shared/manifest.yaml and app/pipelines/*/manifest.yaml
# and pinned by digest in images.lock.json. Nothing to set here.
#
# PRODUCTION MUST SET THIS TO true.
#
# The value below is false so that local development works without a lock file.
# With it false, a missing, truncated or hand-edited images.lock.json is not an
# error: every image silently falls back to the mutable tag in its manifest, and
# a result can no longer be traced to the tool version that produced it. (The
# worker prints a warning to stderr when a lock file exists but cannot be used,
# but a warning is not a control.) Set it true on every deployed host so an
# unpinned image is a startup failure instead:
#
#   REQUIRE_PINNED_IMAGES=true
#
# Break-glass override for a single image, no code change needed:
# DHARINI_IMAGE__ONT_LSDV__CORE=localdev/core:wip
# ---------------------------------------------------------------------------
REQUIRE_PINNED_IMAGES=false
