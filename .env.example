# ===========================================================================
# Dharini Pipeline Service
#
# Copy to .env and fill in. Everything below MUST be set. Anything not listed
# here has a working default in app/config.py -- read that file if you need to
# tune resource ceilings, retry schedules or retention.
# ===========================================================================


# --- Storage paths ---------------------------------------------------------
#
# MUST be absolute host paths, and they are mounted at the identical path
# inside the containers. The worker starts per-tool containers through the host
# Docker daemon, and the daemon resolves bind-mount sources on the host, so
# both sides must agree. Get this wrong and the failure is silent: Docker
# creates an empty directory at the missing path and the tool reports "file not
# found" against data that plainly exists.
#
#   sudo mkdir -p /srv/dharini/runs /srv/dharini/references
#   sudo chown -R $USER /srv/dharini
#
RUNS_ROOT=/srv/dharini/runs
REFS_ROOT=/srv/dharini/references

# GID of the host's docker group, so the worker can use the socket without
# running as root:  getent group docker | cut -d: -f3
DOCKER_GID=999


# --- Database --------------------------------------------------------------
#
# Avoid '$' in this value. docker-compose.yml interpolates it into DATABASE_URL,
# and Compose expands `$` there as a variable reference -- the password the
# container receives is then not the one you set, and Postgres rejects the
# connection with an authentication error that names nothing useful.
POSTGRES_PASSWORD=change-me


# --- Object storage --------------------------------------------------------
S3_BUCKET=your-bucket-name
S3_REGION=ap-south-1

# The folder inside that bucket this deployment owns. Empty = bucket root.
#
# ⚠ MUST equal Dharini's S3_FOLDER exactly. Dharini writes the upload under
#   <S3_FOLDER>/uploads/…; this service reads <S3_PREFIX>uploads/…. Disagree and
#   the object is simply not where this service looks, which surfaces as
#   "422 … does not exist" on every submission and nothing says why.
# Nested paths are fine, and are the point when the bucket is shared: this
# gives the pipeline its own folder inside the app-data folder.
S3_PREFIX=app-data/genomic-sequencing

# Everything then lives under one folder, and nothing this service writes
# lands beside another workload's data:
#
#   your-bucket-name/
#     app-data/
#       genomic-sequencing/
#         uploads/<user>/<upload-id>/<file>     Dharini writes, this reads
#         runs/<run_id>/<artifacts>             this writes, Dharini reads
#
# S3 has no real folders -- "genomic-sequencing/" is just a key prefix, and it
# appears in the console as soon as the first object is written under it.
# Nothing needs creating up front.
#
# The `uploads/` and `runs/` leaf names are NOT configurable -- they are
# mirrored in the IAM policy, so they are constants in app/config.py.
# GET /health reports both effective prefixes, so a mismatch is visible.

# Optional. Real AWS needs no endpoint -- boto3 derives it from S3_REGION.
# Set it only for MinIO or another S3-compatible store.
# S3_ENDPOINT_URL=

# Credentials for that bucket. Set BOTH or NEITHER -- one alone is refused at
# startup, because boto3 would ignore it and quietly reach for whatever else
# the host offers.
#
#   BOTH set    -> used directly. The .env path: same file, same behaviour, on
#                  a laptop and on the server.
#   BOTH empty  -> boto3's own chain: the EC2 instance role if one is attached,
#                  otherwise ~/.aws/credentials or an SSO session.
#
# ⚠ These are long-lived and do not rotate. What keeps the blast radius small
#   is the POLICY behind them, not the file they live in: GetObject on
#   uploads/*, PutObject on runs/*, one bucket, nothing else. Do not widen it
#   to s3:* for convenience -- that trade is the thing actually worth avoiding.
#   Give the IAM user no console access, and rotate on anyone's offboarding.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=



# --- Authentication --------------------------------------------------------
#
# Comma-separated label:secret pairs, e.g.
#   API_KEYS=dharini:<openssl rand -hex 32>,ops:<another>
# Callers send their secret as X-API-Key. The label names the caller in logs and
# makes rotation possible: add the new pair, deploy, migrate the caller, remove
# the old one.
#
# The service refuses to start with API_KEYS empty unless ALLOW_UNAUTHENTICATED
# is true.
API_KEYS=

# LOCAL DEVELOPMENT ONLY. With this true and API_KEYS empty, every /v1 route is
# open to anyone who can reach port 8000.
ALLOW_UNAUTHENTICATED=false


# --- Webhooks --------------------------------------------------------------
#
# Shared with Dharini, which verifies HMAC-SHA256 over "<timestamp>.<body>"
# from the X-Dharini-Signature header. Must match on both sides exactly.
# openssl rand -hex 32
WEBHOOK_SECRET=

# Comma-separated hostnames this service is allowed to call back. Set it: a
# callback URL is client-supplied, and without an allowlist the worker can be
# pointed at internal services or the cloud metadata endpoint.
WEBHOOK_ALLOWED_HOSTS=


# --- Container images ------------------------------------------------------
#
# PRODUCTION MUST SET THIS TO true. Every image in images.lock.json resolves to
# a @sha256: digest; with this set, the service refuses to start if any image
# would resolve to a mutable tag instead, so a result can always be traced to
# the code that produced it.
REQUIRE_PINNED_IMAGES=true


# --- Used only to build artifact links on GET /v1/runs/{id} ----------------
PUBLIC_BASE_URL=http://localhost:8000


# --- Deployment (read by compose.yaml and deploy.sh) -----------------------
#
# Interface port 8000 listens on. 127.0.0.1 is loopback only; use 0.0.0.0 to
# accept other hosts (then restrict the port in your firewall).
API_BIND=127.0.0.1

# Prefix of the Docker volume names. Changing it starts on an empty database; an
# existing installation must keep its current prefix (docs/DEPLOYMENT.md).
COMPOSE_PROJECT_NAME=dharini

# Only if you publish your own image.
# DHARINI_IMAGE=dsihartpark/dharini-mutation-pipeline

# deploy.sh writes APP_VERSION below. Do not edit it.


# ===========================================================================
# Situational — uncomment only when the situation applies
# ===========================================================================

# Local development against MinIO instead of AWS. S3_SSE must be empty: MinIO
# rejects an explicit ServerSideEncryption header unless KMS is configured.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_SSE=

# Browser reads straight from this service, rather than proxied through
# Dharini. Verified locally against Dharini's signing key -- RS256 via JWKS is
# preferred, because this service then holds only a public key and a compromise
# here cannot mint tokens. Bearer auth stays OFF until one of these is set.
# DHARINI_JWT_JWKS_URL=https://dharini.example.org/.well-known/jwks.json
# DHARINI_JWT_ISS=dharini
# DHARINI_JWT_AUD=pipeline
# CORS_ALLOWED_ORIGINS=https://dharini.example.org

# Only when Dharini genuinely sits on a private address inside this network.
# Re-opens the SSRF surface, so pair it with WEBHOOK_ALLOWED_HOSTS above.
# Loopback, link-local, multicast and reserved addresses are refused either way.
# WEBHOOK_ALLOW_PRIVATE_IPS=true
